{
  "name": "zanjerito",
  "version": "1.0.0",
  "description": "A little irrigation controller.",
  "main": "lib/server",
  "scripts": {
    "clean": "rimraf lib",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "webpack --config client/webpack.config.js",
    "prebuild": "npm run clean",
    "build": "npm run build:server && npm run build:client",
    "start:server": "nodemon --watch lib/server --delay 2",
    "start": "concurrently \"npm:build:server -- --watch --preserveWatchOutput\" \"npm:build:client -- --watch\" \"npm:start:server\"",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixnBits/zanjerito.git"
  },
  "keywords": [
    "irrigation",
    "zanjero",
    "valve",
    "drip",
    "water",
    "raspberry",
    "pi"
  ],
  "author": "PixnBits <i@pixnbits.org>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/PixnBits/zanjerito/issues"
  },
  "homepage": "https://github.com/PixnBits/zanjerito#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@americanexpress/env-config-utils": "^2.0.2",
    "@fastify/static": "^8.0.0",
    "duration-fns": "^2.1.0",
    "fastify": "^5.0.0",
    "glob": "^7.2.0",
    "mercurius": "^16.1.0",
    "node-schedule": "^2.0.0",
    "rpi-gpio": "^2.1.7"
  },
  "devDependencies": {
    "@tsconfig/node14": "^1.0.1",
    "@types/glob": "^7.2.0",
    "@types/node": "^15.3.0",
    "@types/node-schedule": "^1.3.1",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "@types/rpi-gpio": "^2.1.1",
    "@types/webpack-dev-server": "^4.5.0",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^6.5.1",
    "graphql-ws": "^5.5.5",
    "html-webpack-plugin": "^5.5.0",
    "mqemitter": "^4.5.0",
    "nodemon": "^2.0.15",
    "prop-types": "^15.8.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rimraf": "^3.0.2",
    "ts-loader": "^9.2.6",
    "typescript": "^5.8.3",
    "urql": "^2.0.6",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1"
  }
}
