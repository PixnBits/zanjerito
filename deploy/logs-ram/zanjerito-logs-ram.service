[Unit]
Description=Zanjerito RAM /var/log (16M tmpfs)
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target
Before=systemd-journald.service systemd-journald.socket systemd-journal-flush.service rsyslog.service syslog.service syslog.target sysinit.target shutdown.target
Conflicts=shutdown.target reboot.target halt.target
IgnoreOnIsolate=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zanjerito-logs-ram.sh start
ExecStop=/usr/local/sbin/zanjerito-logs-ram.sh stop
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=sysinit.target
