# Copied once to /opt/zanjerito/zanjerito.env (install does not overwrite).
# LAN trust only (D7). Bind this Pi LAN address only, e.g.:
LISTEN=192.0.2.10:8080
# fake | dualrun (D9 default) | lockout | gpiocdev
# gpiocdev is wired in the binary; keep DRIVER=dualrun until docs/cutover.md pre-flip gate.
DRIVER=dualrun
