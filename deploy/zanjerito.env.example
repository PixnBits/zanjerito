# Copied once to /opt/zanjerito/zanjerito.env (install does not overwrite).
# LAN trust only (D7). Bind this Pi LAN address only, e.g.:
LISTEN=192.168.5.51:8080
# fake | dualrun | lockout | gpiocdev
# Production on this Pi (post-cutover): gpiocdev. Use fake on a laptop.
# dualrun was the cutover window — see docs/cutover.md for rollback.
DRIVER=gpiocdev
