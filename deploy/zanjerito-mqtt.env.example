# Copied once to /opt/zanjerito/zanjerito-mqtt.env (mode 0600). Never commit the real file.
# Read-only MQTT discovery sidecar for Home Assistant.

# Broker URL (required). Example: tcp://<broker-host>:1883
MQTT_URL=tcp://<broker-host>:1883

# Broker login. Use a dedicated account; do not enable anonymous access.
MQTT_USER=<user>
MQTT_PASS=<password>

# MQTT client id
MQTT_CLIENT_ID=zanjerito-mqtt

# GET snapshot. Must match the daemon LISTEN address (the daemon may not bind loopback).
ZANJERITO_HA_URL=http://<controller-host>:8080/api/ha

# How often to poll GET /api/ha (500ms–10s)
MQTT_POLL_INTERVAL=2s

# Re-publish state even if unchanged
MQTT_REFRESH_INTERVAL=5m
